# ============================================================================
# Discord
# ============================================================================
# Bot token from https://discord.com/developers/applications (see README).
DISCORD_BOT_TOKEN=your-bot-token-here

# Comma-separated list of Discord channel IDs the bot should listen in.
# Right-click a channel in Discord (Developer Mode enabled) -> "Copy Channel ID".
CHANNEL_IDS=123456789012345678,234567890123456789

# ============================================================================
# MediaWiki source
# ============================================================================
# The Action API endpoint of the wiki to index. Any MediaWiki install works —
# the ingest makes no site-specific assumptions.
MEDIAWIKI_API_URL=https://browiki.org/api.php

# Base URL used to build the article links shown in Discord replies, e.g.
# https://browiki.org/wiki/<Page_Title>. Include the trailing slash.
WIKI_ARTICLE_BASE_URL=https://browiki.org/wiki/

# ============================================================================
# Indexing / retrieval tuning
# ============================================================================
# Embedding model (must be a sentence-transformers model; multilingual
# recommended since wiki content + Discord messages are in Portuguese).
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# Where the local Chroma DB persists on disk.
CHROMA_DB_PATH=./data/chroma
CHROMA_COLLECTION_NAME=browiki

# Chunking (approx. tokens, measured as whitespace-split words).
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=50

# Retrieval
# How many candidate pages the bot ranks internally (it replies with the best
# one only).
TOP_K_RESULTS=3
# Minimum hybrid score (0-1) to answer at all: cosine similarity plus a bonus
# when the page title is mentioned in the message. A page named outright in
# the question scores ~0.9. Matches below the threshold are logged, not sent.
SIMILARITY_THRESHOLD=0.55
# Higher bar for a page the message never names, matched on embedding
# similarity alone — ordinary chat scores ~0.7 against unrelated pages
# ("bom dia pessoal" matches the item "Buongiorno"), so those stay silent.
SEMANTIC_ONLY_THRESHOLD=0.78

# ============================================================================
# Intent classification (question detection)
# ============================================================================
# Minimum message length (chars) for a keyword-only match (no "?") to count
# as a question. Prevents the bot from firing on short chatty messages.
QUESTION_MIN_CHARS=12

# Minimum seconds between the bot's own replies within a single channel.
# Debounces very chatty channels so it doesn't answer every message.
REPLY_COOLDOWN_SECONDS=15

# Use a Discord embed for replies (nicer formatting). Set to false for
# plain-text replies instead.
USE_EMBED_REPLIES=true

# Which intent classifier implementation to use: "simple" (default, no API
# key needed) or "llm" (stub for a future LLM-enhanced classifier).
INTENT_CLASSIFIER=simple

# Which answer-writing implementation to use: "simple" (default, reuses the
# indexed page summary, no API key) or "llm" (stub for a future
# LLM-generated, question-tailored description).
ANSWER_WRITER=simple

# Only used if INTENT_CLASSIFIER=llm or ANSWER_WRITER=llm (not required for
# the default free path).
# LLM_API_KEY=
